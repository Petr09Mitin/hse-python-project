# Копировать в .env и подставить токен BotFather; make run/up читают .env через Compose.
TELEGRAM_API_KEY=
# Одна OpenAI-совместимая модель для OCR, разбора чеков и классификации.
OPENAI_BASE_URL=https://api.neuraldeep.ru/v1
OPENAI_MODEL=qwen3.6-35b-a3b-noreason
OPENAI_API_KEY=
# Общий срок graceful shutdown в секундах: (0, 30]. Внешний Compose grace — 40 секунд.
SHUTDOWN_TIMEOUT=30
